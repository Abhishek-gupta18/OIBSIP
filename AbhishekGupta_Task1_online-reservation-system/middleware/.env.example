# RailReserve database configuration template.
# Copy to .env (gitignored) and fill in real values, or export as environment variables.
#
# Local PostgreSQL example:
#   DB_URL=jdbc:postgresql://localhost:5432/railreserve
#
# Supabase session pooler example:
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-password>
